<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IOSBoxAppGroup</key>
	<string>$(IOSBOX_APP_GROUP)</string>
	<key>IOSBoxPrivacyPolicyURL</key>
	<string>$(IOSBOX_PRIVACY_URL)</string>
	<key>IOSBoxSupportEmail</key>
	<string>$(IOSBOX_SUPPORT_EMAIL)</string>
	<key>CFBundleName</key>
	<string>Fugue</string>
	<key>CFBundleDisplayName</key>
	<string>Fugue</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>iosbox</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>用于拍摄照片并发送给 AI 模型进行多模态分析</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于选择图片发送给 AI 模型进行识图与问答</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于连接你在局域网内部署的模型服务（如 Ollama、LM Studio），请求直接发往你填写的地址。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于听写、英语陪练、会议录音和实时语音。你选择云端转写时，录音会发送给配置的转写服务。开始实时通话时，麦克风音频会发送给所选的 Gemini 服务。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于在设备本地使用 Apple 语音识别将你的口述、英语口语练习或会议录音转换为文字（支持离线本地识别时不会上传音频）。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>用于通过面容 ID 解锁「夜奔」以保护你的私人对话与个人记忆。</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Export Compliance Audit:
	     Fugue implements zero custom or third-party cryptographic algorithms. All cryptography relies
	     exclusively on built-in Apple OS frameworks: URLSession (TLS), iOS Keychain, and Apple CryptoKit /
	     CommonCrypto (AES-256-GCM + PBKDF2-HMAC-SHA256) for user-encrypted local backups and WebDAV sync.
	     Under App Store Connect Export Compliance rules ("uses only encryption within Apple's OS"),
	     ITSAppUsesNonExemptEncryption is NO (false). If distributing to the France storefront, submit the
	     French ANSSI encryption declaration in App Store Connect and add ITSEncryptionExportComplianceCode. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array><string>fetch</string></array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array><string>$(PRODUCT_BUNDLE_IDENTIFIER).persona-refresh</string></array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
