<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Cleartext HTTP is explicitly gated at runtime by PrivateCleartextOnlyInterceptor + followSslRedirects=false
         so public hosts are always HTTPS-only while LAN self-hosted endpoints (e.g. Ollama / LM Studio) work. -->
    <issue id="InsecureBaseConfiguration">
        <ignore path="src/main/res/xml/network_security_config.xml" />
    </issue>

    <!-- Deterministic offline builds pin exact dependency & SDK versions in libs.versions.toml and build.gradle.kts. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="OldTargetApi" severity="ignore" />
</lint>
