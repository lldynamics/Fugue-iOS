{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fugue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜奔"
          }
        }
      }
    },
    "CFBundleName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fugue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜奔"
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to add confirmed schedule items from conversations to your Calendar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在你点击确认后将对话中提炼的日程写入系统日历。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to take photos and send them to AI models for analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拍摄照片并发送给 AI 模型进行多模态分析"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to unlock Fugue with Face ID to protect your private chats and personal memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于通过面容 ID 解锁「夜奔」以保护你的私人对话与个人记忆。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to connect to model servers on your local network (such as Ollama or LM Studio). Requests go directly to the address you enter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于连接你在局域网内部署的模型服务（如 Ollama、LM Studio），请求直接发往你填写的地址。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to dictate chat messages by voice through the microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于通过麦克风进行语音听写输入对话内容。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to choose images to send to AI models for analysis and Q&A."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于选择图片发送给 AI 模型进行识图与问答"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to add confirmed action items from conversations to your Reminders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在你点击确认后将对话中提炼的待办事项加入系统提醒事项。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to transcribe your voice into chat message text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将你的语音实时转换为对话文本输入。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
