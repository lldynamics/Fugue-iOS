{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fugue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜奔"
          }
        }
      }
    },
    "CFBundleName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fugue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜奔"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to take photos and send them to AI models for analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拍摄照片并发送给 AI 模型进行多模态分析"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to unlock Fugue with Face ID to protect your private chats and personal memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于通过面容 ID 解锁「夜奔」以保护你的私人对话与个人记忆。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to connect to model servers on your local network (such as Ollama or LM Studio). Requests go directly to the address you enter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于连接你在局域网内部署的模型服务（如 Ollama、LM Studio），请求直接发往你填写的地址。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for voice dictation, English speaking practice, and recording voice notes; audio is captured only when you start recording, processed on-device by default, and sent to your configured provider only when you choose cloud transcription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于语音听写输入、英语口语陪练及录制会议语音纪要；仅在你主动开始录音时采集音频，默认使用设备本地识别，仅在你选择云端转写时发送至你配置的服务商。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to choose images to send to AI models for analysis and Q&A."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于选择图片发送给 AI 模型进行识图与问答"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to transcribe your dictation, English speaking practice, or recorded notes on-device with Apple Speech Recognition (audio stays on your device when offline recognition is supported)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在设备本地使用 Apple 语音识别将你的口述、英语口语练习或会议录音转换为文字（支持离线本地识别时不会上传音频）。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
