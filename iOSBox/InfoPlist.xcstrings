{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fugue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜奔"
          }
        }
      }
    },
    "CFBundleName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fugue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜奔"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to take photos and send them to AI models for analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拍摄照片并发送给 AI 模型进行多模态分析"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to unlock Fugue with Face ID to protect your private chats and personal memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于通过面容 ID 解锁「夜奔」以保护你的私人对话与个人记忆。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to connect to model servers on your local network (such as Ollama or LM Studio). Requests go directly to the address you enter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于连接你在局域网内部署的模型服务（如 Ollama、LM Studio），请求直接发往你填写的地址。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for dictation, speaking practice, voice notes, and live conversations. Cloud transcription sends recordings to your configured service. Starting a live call streams microphone audio to your selected OpenAI or Google Gemini service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于听写、英语陪练、会议录音和实时语音。你选择云端转写时，录音会发送给配置的转写服务。开始实时通话时，麦克风音频会发送给所选的 OpenAI 或 Google Gemini 服务。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to choose images to send to AI models for analysis and Q&A."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于选择图片发送给 AI 模型进行识图与问答"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to transcribe your dictation, English speaking practice, or recorded notes on-device with Apple Speech Recognition (audio stays on your device when offline recognition is supported)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在设备本地使用 Apple 语音识别将你的口述、英语口语练习或会议录音转换为文字（支持离线本地识别时不会上传音频）。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
