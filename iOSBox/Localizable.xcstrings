      }
    },
    "开启后收起新建群聊、邀请和部分对话工具。多模型对比由下方开关控制，用量可在设置中查看。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides new group chats, invitations, and some chat tools. Use the switch below to control model comparison. Usage is available in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后收起新建群聊、邀请和部分对话工具。多模型对比由下方开关控制，用量可在设置中查看。"
          }
        }
      }
    },
    "开启后点击消息「朗读回复」会优先生成更自然的云端人声；如网络失败、未授权或无可用服务商，将自动静默回退到免费 iOS 系统语音。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, tapping Read Aloud prefers natural cloud speech and falls back silently to free iOS system speech if offline, unauthorized, or unconfigured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后点击消息「朗读回复」会优先生成更自然的云端人声；如网络失败、未授权或无可用服务商，将自动静默回退到免费 iOS 系统语音。"
          }
        }
      }
    },
    "开启后，仅对缺少单价的历史记录补充本次单价，不会覆盖已有计价快照。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies this rate only to past requests missing pricing, preserving existing priced snapshots."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，仅对缺少单价的历史记录补充本次单价，不会覆盖已有计价快照。"
          }
        }
      }
    },
    "开启后，冷启动或切回「夜奔」超过锁定延迟时需通过系统验证，防止他人拿起手机直接翻阅敏感对话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires authentication on launch or when returning to Fugue after the selected delay to keep private chats protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，冷启动或切回「夜奔」超过锁定延迟时需通过系统验证，防止他人拿起手机直接翻阅敏感对话。"
          }
        }
      }
    },
    "开启后，将启用的记忆发送给此会话使用的模型。发送前可选择「本次不使用记忆」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send enabled memories to models used in this chat. Choose Skip Memory This Time before sending to omit them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，将启用的记忆发送给此会话使用的模型。发送前可选择「本次不使用记忆」。"
          }
        }
      }
    },
    "开启后，这位好友会在私聊与圆桌群聊中持续记住你们的共同话题、近况与约定（群聊中仅注入给该好友自身模型，不泄露给其他成员）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, this friend remembers shared topics, updates, and promises across private and group chats (in group chats, memories are sent only to this friend's own model)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，这位好友会在私聊与圆桌群聊中持续记住你们的共同话题、近况与约定（群聊中仅注入给该好友自身模型，不泄露给其他成员）。"
          }
        }
      }
    },
    "开启后，进入系统多任务切换界面时将自动以毛玻璃遮挡当前页面；启用应用锁时防窥遮罩会始终开启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically blurs app previews in the iOS app switcher. Always active while App Lock is enabled."
