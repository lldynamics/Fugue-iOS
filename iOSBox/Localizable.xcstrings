    "支持 TXT、Markdown 和 JSON，文件最大 2 MB。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a TXT, Markdown, or JSON file up to 2 MB."
          }
