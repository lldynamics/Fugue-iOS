            "value": "将发送哪些数据"
          }
        }
      }
    },
    "将所选图片和问题发给 %@。同意此次及后续主动发起的 AI 请求？可在「夜奔」中撤回。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the selected image and question to %@? Your approval also covers future AI requests you initiate. You can withdraw it in Fugue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选图片和问题发给 %@。同意此次及后续主动发起的 AI 请求？可在「夜奔」中撤回。"
          }
        }
      }
    },
    "将移除「%@」及其保存在本机钥匙串中的 API Key 与敏感请求头。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
