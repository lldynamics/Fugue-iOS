        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，进入系统多任务切换界面时将自动以毛玻璃遮挡当前页面；启用应用锁时防窥遮罩会始终开启。"
          }
        }
      }
    },
