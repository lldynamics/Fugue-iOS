    },
    "使用 /v1/messages 接口，原生支持 Extended Thinking 与 PDF 文档": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses /v1/messages with native Extended Thinking and PDF support"
