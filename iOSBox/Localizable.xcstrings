            "state": "translated",
            "value": "Decodes QR codes containing API keys, endpoint URLs, JSON configs, or setup links locally on your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持解析包含 API Key、接口地址、JSON 配置或一键导入链接的二维码，图像全程仅在本机离线识别。"
          }
        }
      }
    },
    "支持随时修改；若使用末尾带 # 的自定义网关地址可跳过自动拼接 /v1。": {
      "localizations": {
        "en": {
