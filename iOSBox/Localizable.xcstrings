    "支持坚果云、Nextcloud、群晖 NAS 等标准 WebDAV。公网仅允许 HTTPS；局域网可使用 HTTP。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supports Jianguoyun, Nextcloud, Synology NAS, and standard WebDAV servers (HTTPS on public hosts; HTTP allowed on LAN)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持坚果云、Nextcloud、群晖 NAS 等标准 WebDAV。公网仅允许 HTTPS；局域网可使用 HTTP。"
          }
        }
      }
    },
