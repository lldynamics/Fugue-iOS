    "请先配置并启用 OpenAI 兼容服务商，或切换为「设备免费识别」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure and enable an OpenAI-compatible provider first, or switch to On-Device (Free)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先配置并启用 OpenAI 兼容服务商，或切换为「设备免费识别」。"
          }
        }
      }
    },
    "请各模型审阅同组其他候选答案，吸收优点并修正遗漏或错误，给出完善后的最终回答。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please review the peer candidate answers in this comparison, incorporate their strengths, fix any omissions or errors, and provide a refined final answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请各模型审阅同组其他候选答案，吸收优点并修正遗漏或错误，给出完善后的最终回答。"
          }
        }
      }
    },
    "请同时填写两个非负单价，或同时留空。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter both nonnegative prices, or leave both empty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请同时填写两个非负单价，或同时留空。"
          }
        }
      }
    },
